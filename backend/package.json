{
  "name": "@ks/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "db:dev": "tsx src/scripts/dev-db.ts",
    "db:stop": "tsx src/scripts/dev-db.ts stop",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "verify-import": "tsx src/scripts/verify-import.ts",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "books:golden": "tsx src/scripts/books-golden.ts",
    "books:golden:update": "tsx src/scripts/books-golden.ts --update"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@node-rs/argon2": "^2.0.2",
    "decimal.js-light": "^2.5.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.3.2",
    "fastify-plugin": "^5.1.0",
    "jose": "^6.0.10",
    "jszip": "^3.10.1",
    "pg": "^8.16.0",
    "pino": "^9.6.0",
    "saxes": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.1",
    "embedded-postgres": "^17.2.0-beta.15",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
