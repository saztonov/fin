# DDL-роль для миграций (deploy-fin --migrate). Копия живёт в /etc/fin/fin-migrate.env
# (640 root:docker), в git НЕ коммитится. Читает ТОЛЬКО deploy-fin.sh — эта роль никогда
# не попадает в рантайм-контейнеры fin-api/fin-worker (там — fin.env с ролью fin_runtime).
#
# ВАЖНО: этот файл не печатать в чат/лог целиком (в нём пароль DDL-роли).
MIGRATE_DATABASE_URL=postgres://fin_migration:ПАРОЛЬ@<host>:6432/fin?sslmode=verify-full
