# Заготовка маршрутизации портала «КС» для nginx на backend-vps-1 (этап 2 — боевой домен и TLS).
# Frontend собирается статикой (frontend/dist) и раздаётся nginx с того же origin,
# поэтому CORS не нужен (корпстандарт §23).
server {
    listen 443 ssl;
    server_name ks.su10.ru;

    # ssl_certificate     /etc/letsencrypt/live/ks.su10.ru/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/ks.su10.ru/privkey.pem;

    client_max_body_size 26m;          # согласовано с UPLOAD_MAX_BYTES
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    location /api/ {
        proxy_pass http://127.0.0.1:3010;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
    }

    location /health/ {
        proxy_pass http://127.0.0.1:3010;
    }

    location / {
        root /opt/portals/ks/frontend;
        try_files $uri /index.html;
    }
}

server {
    listen 80;
    server_name ks.su10.ru;
    return 301 https://$host$request_uri;
}
