# Портал «КС» (fin) — production-конфиг. Копия живёт в /etc/fin/fin.env (640 root:docker),
# в git НЕ коммитится. Ключи соответствуют envSchema в backend/src/config.ts.
#
# ВАЖНО: этот файл не печатать в чат/лог целиком (в нём пароли и JWT-секрет).

NODE_ENV=production
API_PORT=3000
# API_HOST задаёт deploy/docker-compose.prod.yml (0.0.0.0) — здесь не указывать

# Managed PostgreSQL (Yandex, порт 6432 через балансировщик). Роль fin_runtime — только
# INSERT/UPDATE/SELECT/DELETE (DDL-права см. в deploy/fin-migrate.env.example).
# TLS обязателен: либо sslmode=verify-full в URL, либо DB_CA_CERT_PATH ниже (нужно и то,
# и другое для verify-full — sslmode в URL плюс CA-файл для проверки цепочки).
DATABASE_URL=postgres://fin_runtime:ПАРОЛЬ@<host>:6432/fin?sslmode=verify-full
DB_POOL_MAX=10
DB_CA_CERT_PATH=/etc/fin/root.crt

# openssl rand -base64 48
JWT_SECRET=
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=2592000

# Первый администратор — нужен ТОЛЬКО на время `docker compose ... run --rm seed`.
# После успешного сида закомментировать SEED_ADMIN_PASSWORD (значение больше не требуется).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Файлы импорта — том uploads (см. docker-compose.prod.yml), путь относительно WORKDIR
# контейнера (/app/backend) резолвится в /app/.data/uploads. Менять не нужно.
STORAGE_DIR=.data/uploads
UPLOAD_MAX_BYTES=26214400

WORKER_POLL_MS=1000
PARSE_TIMEOUT_MS=60000

# Домен портала — используется только при рендере deploy/nginx/fin.conf.template
# (envsubst), в само приложение не попадает. Пока домен не выбран — оставить пустым.
FIN_DOMAIN=
