# === Портал КС: переменные окружения (backend) ===
# Скопируйте в .env и заполните. .env не коммитится.

# Окружение: development | production | test
NODE_ENV=development

# --- API ---
API_HOST=127.0.0.1
API_PORT=3000

# --- PostgreSQL ---
# dev-БД поднимается командой `npm run db:dev` (embedded-postgres, localhost:5439)
DATABASE_URL=postgres://ks:ks@127.0.0.1:5439/ks
# Максимум соединений пула (api и worker считаются отдельно)
DB_POOL_MAX=10
# Путь к CA-сертификату для TLS-подключения (production, Yandex Managed PostgreSQL)
# DB_CA_CERT_PATH=/etc/ssl/root.crt

# --- Auth ---
# Секрет подписи access JWT (HS256). В production — из secret storage, длина >= 32.
JWT_SECRET=dev-secret-change-me-0000000000000000
# Время жизни access-токена, сек
ACCESS_TTL_SEC=900
# Время жизни refresh-токена, сек (30 дней)
REFRESH_TTL_SEC=2592000

# --- Первый администратор (создаётся скриптом seed) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Администратор

# --- Файлы импорта ---
# Локальное хранилище (S3 — этап 2)
STORAGE_DIR=.data/uploads
# Лимит размера загружаемого файла, байт (25 МБ)
UPLOAD_MAX_BYTES=26214400

# --- Worker ---
# Период опроса очереди задач, мс
WORKER_POLL_MS=1000
# Таймаут разбора Excel в дочернем процессе, мс
PARSE_TIMEOUT_MS=60000
